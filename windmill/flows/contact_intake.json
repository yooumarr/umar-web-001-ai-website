{
    "summary": "Contact form intake: validates the payload and stores it idempotently via store_submission",
    "description": "Single-step flow used as a synchronous contact-form webhook. It forwards the `payload` flow input to the workspace script u/umarworkit/store_submission, which inserts one row into contact_submissions and dedupes on the request_id primary key. The flow's result is the step's result untouched, so a sync webhook call answers with exactly {\"stored\":true,\"request_id\":\"...\"}.",
    "value": {
        "modules": [
            {
                "id": "store_submission",
                "value": {
                    "path": "u/umarworkit/store_submission",
                    "type": "script",
                    "input_transforms": {
                        "db": {
                            "type": "static",
                            "value": "$res:u/umarworkit/supabase_demo_db"
                        },
                        "payload": {
                            "expr": "flow_input.payload",
                            "type": "javascript"
                        }
                    }
                },
                "summary": "Store the contact submission (idempotent on request_id)"
            }
        ]
    },
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
            "payload": {
                "type": "object",
                "description": "The contact form submission.",
                "properties": {
                    "request_id": {
                        "type": "string",
                        "format": "uuid",
                        "description": "Idempotency key generated by the form. Resubmitting the same value does not create a second row."
                    },
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Submitter's name."
                    },
                    "email": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Submitter's email address."
                    },
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The message body."
                    }
                },
                "required": [
                    "request_id",
                    "name",
                    "email",
                    "message"
                ]
            }
        },
        "required": [
            "payload"
        ]
    }
}